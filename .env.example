MONGODB_URI=mongodb://127.0.0.1:27017/edunotify
PORT=5000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Africa's Talking credentials
# Copy the sandbox API key from the Africa's Talking dashboard.
AT_API_KEY=your-africastalking-api-key
# Use sandbox while testing; use your approved account username in production.
AT_USERNAME=sandbox

# Used by seed.js
SEED_PASSWORD=ChangeMe123!
# Set this to the exact phone number registered in the Africa's Talking simulator.
TEST_PARENT_PHONE=+233200000000

VITE_API_URL=http://localhost:5000/api
