TEST_PARENT_PHONE=

VITE_API_URL=


# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# SMS: Africa's Talking (use "sandbox" as the username while testing)
AT_API_KEY=
